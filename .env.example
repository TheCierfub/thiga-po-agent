# Copier vers .env et remplir. Sans .env, le mode rejoué et l'export Markdown suffisent.
# Ne jamais committer .env.

# --- Modèles (pnpm eval:compare, pnpm agent --provider real) ---

# pnpm eval:compare et --profile ne lisent que celle-ci.
OPENROUTER_API_KEY=
# Facultatif : autre racine d'API (proxy). Défaut : https://openrouter.ai/api
OPENROUTER_BASE_URL=

# --provider real sans --profile : un seul fournisseur pour toutes les étapes.

# openai | anthropic | openrouter
LLM_PROVIDER=
# Identifiant du modèle chez ce fournisseur.
LLM_MODEL=

# Seule la clé du fournisseur choisi est lue (OPENROUTER_API_KEY ci-dessus pour openrouter).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Linear (bouton d'export de l'interface, pnpm export:linear) ---

# Linear > Settings > Account > Security & access > Personal API keys.
LINEAR_API_KEY=
# UUID de l'équipe, ou sa clé (le préfixe des issues, par exemple THI).
LINEAR_TEAM_ID=
# 32 octets en base64, pour chiffrer la clé Linear du navigateur. openssl rand -base64 32
# À définir sur Render. Sans elle, une clé personnelle ne peut pas être gardée.
LINEAR_KEY_COOKIE_SECRET=
# Facultatif : 0 pour ne pas créer de demandes clients (Customer Requests).
LINEAR_CUSTOMER_REQUESTS=
# Facultatif : adresse publique de l'interface, pour les liens vers les feedbacks. Défaut : http://localhost:43217
ETAI_PUBLIC_URL=

# Code partagé de la démo. Sans lui, l'application refuse l'accès.
DEMO_ACCESS_CODE=
# Secret HMAC du cookie d'accès (openssl rand -base64 32). Sans lui, l'accès reste fermé.
ACCESS_COOKIE_SECRET=

# --- Supabase (persistance, côté serveur uniquement) ---

# Ne jamais préfixer par NEXT_PUBLIC_ : la table des feedbacks contient les textes bruts.
# URL du projet, par exemple https://xxxx.supabase.co
SUPABASE_URL=
# Clé publishable (sb_publishable_…). Rôle anon, borné par les politiques RLS.
# Pas la clé secrète, pas la clé service_role.
SUPABASE_KEY=
# Plafonds globaux par jour, heure de Paris. Défauts : 30 stories, 200 classifications, 20 exports.
QUOTA_STORY_GLOBAL=
QUOTA_FEEDBACK_GLOBAL=
QUOTA_EXPORT_GLOBAL=
# Facultatif : profil OpenRouter pour un feedback ajouté dans l'interface. Défaut : B
# (Jev décide, Sonnet rédige). A et C restent possibles.
ETAI_LLM_PROFILE=
# Facultatif : confiance minimale de Jev pour rattacher à un thème sans appel de regroupement. Défaut : 0.8
ETAI_THEME_CONFIDENCE=
# Facultatif : plafond en dollars pour une analyse de feedback. Défaut : 1
ETAI_LLM_BUDGET_USD=

# --- Écoute X (Treg, côté serveur uniquement) ---

# Jeton d'équipe Treg. Jamais NEXT_PUBLIC_, jamais écrit dans les logs.
TREG_TOKEN=
# Facultatif : requête suivie. Défaut : #etai OR @etai
ETAI_X_QUERY=
# Facultatif : secondes entre deux passages tant que la page est ouverte. Défaut : 20, minimum : 10
ETAI_X_POLL_SECONDS=
# Facultatif : plafond de coût Treg pour une session de page. Défaut : 0.50
ETAI_X_MAX_SESSION_USD=
# Facultatif : âge maximum d'un post, en jours. Défaut : 7
ETAI_X_MAX_AGE_DAYS=
