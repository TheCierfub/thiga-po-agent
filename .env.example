# Copier vers .env pour utiliser un vrai modèle (--provider real). Sans .env, le mode rejoué suffit.
# Ne jamais committer .env.

# openai | anthropic | openrouter
LLM_PROVIDER=
# Identifiant du modèle chez ce fournisseur.
LLM_MODEL=

# Seule la clé du fournisseur choisi est lue.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
